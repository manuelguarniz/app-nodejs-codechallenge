{
  "openapi": "3.0.4",
  "info": {
    "title": "API Transactions",
    "version": "1.0.0",
    "description": "API for processing transactions"
  },
  "produces": [
    "application/json"
  ],
  "servers": [
    {
      "url": "http://localhost:8080",
      "description": "Servidor local"
    }
  ],
  "paths": {
    "/api/health": {
      "get": {
        "summary": "Get health api status",
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/api/transaction/{id}": {
      "get": {
        "summary": "Get detail from transaction",
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "schema": {
              "type": "string"
            },
            "required": "true",
            "description": "This value is a transction id"
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/responses/schemas/TransactionResponse"
                }
              }
            }
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/responses/schemas/SimpleErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/transaction": {
      "post": {
        "summary": "Transfer funds",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/responses/schemas/CreateTransactionRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/responses/schemas/CreateTransactionResponse"
                }
              }
            }
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/responses/schemas/DetailErrorResponse"
                }
              }
            }
          }
        }
      }
    }
  },
  "responses": {
    "schemas": {
      "DetailErrorResponse": {
        "type": "object",
        "properties": {
          "message": {
            "type": "string",
            "description": "Error message"
          },
          "errors": {
            "type": "array",
            "description": "List error messages",
            "items": {
              "type": "string"
            }
          }
        }
      },
      "SimpleErrorResponse": {
        "type": "object",
        "properties": {
          "message": {
            "type": "string",
            "description": "Error message"
          }
        }
      },
      "CreateTransactionResponse": {
        "type": "object",
        "properties": {
          "operationTransactionId": {
            "type": "string",
            "description": "Transaction ID"
          }
        }
      },
      "CreateTransactionRequest": {
        "type": "object",
        "properties": {
          "accountExternalIdDebit": {
            "type": "string",
            "description": "Account Debit ID"
          },
          "accountExternalIdCredit": {
            "type": "string",
            "description": "Account Credit ID"
          },
          "tranferTypeId": {
            "type": "number",
            "description": "Transaction Type"
          },
          "value": {
            "type": "number",
            "description": "Amount tranfer"
          }
        }
      },
      "TransactionStatus": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "enum": "[pending, approved, rejected]",
            "description": "Transaction Status"
          }
        }
      },
      "TransactionType": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "description": "Transaction Type"
          }
        }
      },
      "TransactionResponse": {
        "type": "object",
        "properties": {
          "transactionExternalId": {
            "type": "string",
            "description": "Transaction ID"
          },
          "transactionType": {
            "$ref": "#/responses/schemas/TransactionType"
          },
          "transactionStatus": {
            "$ref": "#/responses/schemas/TransactionStatus"
          },
          "value": {
            "type": "string",
            "description": "Transaction Amount"
          },
          "createdAt": {
            "type": "string",
            "description": "Transaction Date",
            "example": "yyyy-MM-dd HH:mm:ss"
          }
        }
      }
    }
  }
}